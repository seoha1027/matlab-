1번
clear; clc; 
t = 0:0.01:30;
%(a)
f = exp(-0.12*t).*sin(5*t) + 0.3.*cos(2*t);
plot(t,f)
hold on
%(b)
u = exp(-0.12*t) + 0.3;
l = -exp(-0.12*t)- 0.3;
plot(t,u,'r-')
plot(t, l,'b-')
legend('f(t)', 'u(t)', 'l(t)');
title('1번 그래프')
xlabel('t');
ylabel('f(t)');
%(c)
idx = find(f(2:end-1) > f(1:end-2) & f(2:end-1) > f(3:end)) + 1;
%(d)
plot(t(idx), f(idx), 'yo')
%(e)
result = table(t(idx)', f(idx)', 'VariableNames', {'t_value', 'f_value'});
disp(result)

2번
clear; clc;
figure;
x = -5:0.05:5; y = -5:0.05:5;
%(a)
[X,Y] = meshgrid(x,y);
Z = sin(X.*Y)./(1+X.^2+Y.^2);
%(b)
mesh(X,Y,Z)
title('2번 mesh 그래프')
xlabel('x')
ylabel('y')
zlabel('z')
figure;
%(c)
contour(X,Y,Z,25)
title('2번 contour 그래프')
xlabel('x')
ylabel('y')
%(d)
max_val = max(abs(Z(:)));
fprintf('절대값 Z의 최대값 : %.4f\n', max_val)
%(e)
idx = find(abs(Z) == max_val);
[row,col] = ind2sub(size(Z), idx);
for k = 1: length(row)
    x_pos = X(row(k),col(k));
    y_pos = Y(row(k), col(k));

    fprintf('x = %.2f, y = %.2f\n', x_pos, y_pos);
end

