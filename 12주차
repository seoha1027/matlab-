% (e)
signal(30) = 80; signal(75) = -20; signal(110) = 95;

% (f)
idxMissing = isnan(signal);
numMissing = sum(idxMissing);

% (g)
meanSignal = mean(signal(~idxMissing));
signalFilled = signal;
signalFilled(idxMissing) = meanSignal;

% (h)
mu = mean(signalFilled);
sigma = std(signalFilled);
idxOutlier = abs(signalFilled - mu) > 3 * sigma;

% (i)
signalClean = signalFilled;
signalClean(idxOutlier) = NaN;

% (j)
validSignal = signalClean(~isnan(signalClean));

% (k)
minVal = min(validSignal); maxVal = max(validSignal);
normSignal = (validSignal - minVal) / (maxVal - minVal);

% (l)
finalMean = mean(normSignal);
finalVar = var(normSignal);

% (m)
figure;
tiledlayout(2, 1);
nexttile;
plot(validSignal, 'b-', 'LineWidth', 1.5);
title('Valid Signal'); xlabel('Index'); ylabel('Amplitude');
grid on; set(gca, 'FontSize', 12, 'LineWidth', 1.5);

nexttile;
plot(normSignal, 'r-', 'LineWidth', 1.5);
title('Normalized Signal'); xlabel('Index'); ylabel('Normalized Value');
