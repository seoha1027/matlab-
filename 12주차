clear; clc;
% (a)
x = -5:0.05:5;
y = -5:0.05:5;

[X, Y] = meshgrid(x, y);

% (b)
Z = exp(-0.08*(X.^2 + Y.^2)) ...
    .* sin(3*X) ...
    .* cos(2*Y) ...
    + 0.15*sin(X.*Y);

% (c)
figure;

surf(X, Y, Z);

% (d)
shading interp;

colorbar;

% (e)
xlabel('x-axis');

ylabel('y-axis');

zlabel('z = f(x,y)');

% (f)
title('Detailed Surface Plot of a Multivariable Function');

% (g)
grid on;

set(gca, 'FontSize', 12, 'LineWidth', 1.5);

% (h)
view(45,30);

% (i)
hold on;

planeZ = zeros(size(Z));

surf(X, Y, planeZ, ...
    'FaceAlpha', 0.3, ...
    'EdgeColor', 'none');

% (j)
maxZ = max(Z(:));

minZ = min(Z(:));

% (k)
[rowMax, colMax] = find(Z == maxZ, 1);

[rowMin, colMin] = find(Z == minZ, 1);

maxPoint = [X(rowMax,colMax), ...
            Y(rowMax,colMax), ...
            Z(rowMax,colMax)];

minPoint = [X(rowMin,colMin), ...
            Y(rowMin,colMin), ...
            Z(rowMin,colMin)];

% (l)
plot3(maxPoint(1), maxPoint(2), maxPoint(3), ...
      'ro', 'MarkerSize', 10, ...
      'MarkerFaceColor', 'r');

plot3(minPoint(1), minPoint(2), minPoint(3), ...
      'bs', 'MarkerSize', 10, ...
      'MarkerFaceColor', 'b');

legend('Surface', ...
       'z=0 plane', ...
       'Maximum point', ...
       'Minimum point');

% (m)
saveas(gcf, 'complex_surface.png');


disp(maxZ);
disp(minZ);

disp(maxPoint);
disp(minPoint);
