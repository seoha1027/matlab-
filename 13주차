function r = mypoissrnd(lambda, m, n)
    r = zeros(m, n);
    for i = 1:m
        for j = 1:n
            L = exp(-lambda);
            k = 0;
            p = 1;

            while p > L
                k = k + 1;
                p = p * rand;
            end

            r(i, j) = k - 1;
        end
    end
end


