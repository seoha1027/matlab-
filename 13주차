arrival_interval = -8 * log(rand(300,1)); 

arrival_time = cumsum(arrival_interval);

service_time = 10 + 3*randn(300,1);    
service_time(service_time < 0) = 1;

start_time = zeros(300,1);             
end_time = zeros(300,1);

start_time(1) = arrival_time(1);
end_time(1) = start_time(1) + service_time(1);

for i = 2:300
    start_time(i) = max(arrival_time(i), end_time(i-1));
    end_time(i) = start_time(i) + service_time(i);
end

waiting_time = start_time - arrival_time;  
avg_wait = mean(waiting_time);              
max_wait = max(waiting_time);
ratio = mean(waiting_time > 20);

fprintf('평균 대기시간 = %.2f분\n', avg_wait);
fprintf('최대 대기시간 = %.2f분\n', max_wait);
fprintf('20분 초과 비율 = %.4f\n', ratio);

figure;
histogram(waiting_time);
xlabel('Waiting Time (min)');
ylabel('Number of Patients');
title('Waiting Time Distribution');

