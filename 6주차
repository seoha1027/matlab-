fprintf('8번\n')

price = [19, 18, 22, 21, 25, 19, 17, 21, 27, 29];
share = 1000;
consume = 0;
income = 0;
for i= 1: 10
    if price(i) < 20
        share = share+100;
        consume = consume + price(i)*100;
    elseif price(i) > 25
        share = share-100;
        income = income + price(i)*100;
    end
end
initial_value = 1000*price(1);
final_value = (share*price(10)) + income - consume;
increase = final_value - initial_value;

fprintf('(a) 주식을 사는 데 소비한 금액 : %d\n',consume)
fprintf('(b) 주식을 팔아서 얻어진 금액 : %d\n', income)
fprintf('(c) 10일째가 지난 후에 보유하고 있는 주식의 수 : %d\n', share)
fprintf('(d) 총 가치의 증가분 : %d', increase);

