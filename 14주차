plot(1:30,dailyTotal,'-o');
hold on;
plot(find(busyDay),dailyTotal(busyDay), ...
    'r*','MarkerSize',10);
xlabel('Day');
ylabel('Total Requests');
title('Daily Delivery Request Simulation');
grid on;
