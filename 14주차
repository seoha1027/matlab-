rng(14);
%% (b)
requests = zeros(30,12);
for i = 1:30
    for j = 1:12
        lambda = 18;
        L = exp(-lambda);
        k = 0;
        p = 1;
        while p > L
            k = k + 1;
            p = p * rand;
        end
        requests(i,j) = k - 1;
    end
end
